# ====================================================
# Настройки ВКонтакте (VK API)
# ====================================================
# Токен сообщества ВКонтакте (получить в Настройки -> Работа с API)
VK_GROUP_TOKEN=your_vk_group_token_here
# ID сообщества (число, например: 123456789)
VK_GROUP_ID=123456789

# ====================================================
# Настройки Битрикс24 (Bitrix24 REST API)
# ====================================================
# URL входящего вебхука (с правом crm). Например: https://your_domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=https://your_domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ====================================================
# Настройки Яндекс Таблиц (Yandex REST API / Google Sheets / CSV Fallback)
# ====================================================
# Токен доступа (OAuth-токен Яндекс или сервисный ключ)
YANDEX_OAUTH_TOKEN=your_yandex_token_here
# Путь к файлу таблицы на Яндекс Диске (или ID таблицы)
YANDEX_SHEET_PATH=/Таблицы/Фиксация_клиентов_СТС_Групп.xlsx
# Имя локальной таблицы для резервного/тестового сохранения (если API недоступен или токен не задан)
LOCAL_BACKUP_SHEET=realtor_clients_backup.csv

# ====================================================
# Настройки уведомлений администратора (SMTP Email)
# ====================================================
ADMIN_EMAIL=admin@stc-group.ru
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=bot-alert@stc-group.ru
SMTP_PASSWORD=your_email_password_here

# ====================================================
# Настройки базы данных сессий и логов
# ====================================================
DB_PATH=sessions.db
LOGS_DIR=logs
SESSION_TTL_HOURS=24
